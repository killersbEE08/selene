# Cloudflare Pages redirects — https://developers.cloudflare.com/pages/configuration/redirects/
#
# NOTE: Cloudflare Pages already serves clean URLs automatically and redirects
# "/page.html" -> "/page". So we must NOT redirect "/page" -> "/page.html"
# (that creates an infinite loop). These rules only add extra *aliases* that
# point at the canonical clean URLs.

/privacy-policy    /privacy         301
/tos               /terms           301
/delete            /delete-account  301
/account-deletion  /delete-account  301
